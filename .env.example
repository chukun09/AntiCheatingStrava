PORT=3000

# PostgreSQL Connection String (Supabase / Neon / Render or Local Postgres)
# Note: Use Supabase Pooler Port 6543 (IPv4 Ready) with pgbouncer=true & connection_limit=5
DATABASE_URL="postgresql://postgres.xnmocskcosadgzdoaruq:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbooster=true&connection_limit=5&pgbouncer=true"

# Telegram Bot Config (Single Group ID for BTC)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_GROUP_ID="-1001234567890"

# Strava OAuth & Webhook Config
STRAVA_CLIENT_ID="your_strava_client_id"
STRAVA_CLIENT_SECRET="your_strava_client_secret"
STRAVA_VERIFY_TOKEN="my_secret_token"

# Strava Multi-App Pool Config (Mỗi App gánh tối đa 10 VĐV)
# Thêm bao nhiêu App tuỳ thích vào mảng JSON bên dưới:
STRAVA_APPS_JSON='[{"clientId":"111111","clientSecret":"secret_app_1"},{"clientId":"222222","clientSecret":"secret_app_2"}]'

# App Public URL (Ngrok or Render domain)
APP_BASE_URL="https://your-domain.ngrok-free.app"

# Set to true during pre-contest test phase (before 03/08/2026) to allow test runs
ALLOW_TEST_DATE=true
